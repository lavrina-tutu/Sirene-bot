{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pair-scoped identity mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pairs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_kind",
          "from_key",
          "to_key",
          "identity_key"
        ],
        "properties": {
          "entity_kind": {
            "enum": [
              "task",
              "resource",
              "calendar",
              "assignment"
            ]
          },
          "from_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "to_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "identity_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
