{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Batch manifest v1; IANA and unique IDs additionally checked by validate_manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "on_error": {
      "enum": [
        "continue",
        "stop"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "path",
          "project_slug"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "project_slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "lineage_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_version_date": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "expected_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "timezone_hint": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
