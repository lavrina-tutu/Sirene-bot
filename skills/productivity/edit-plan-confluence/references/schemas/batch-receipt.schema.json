{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Batch receipt v1; balance checked by validate_batch_receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "mode",
    "status",
    "exit_code",
    "manifest_sha256",
    "inputs_frozen_at",
    "on_error",
    "counts",
    "items",
    "published",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "const": "batch_save"
    },
    "status": {
      "enum": [
        "completed",
        "completed_with_errors",
        "stopped",
        "infrastructure_stopped",
        "conflict",
        "failed"
      ]
    },
    "exit_code": {
      "type": "integer",
      "enum": [
        0,
        2,
        4,
        5,
        6
      ]
    },
    "manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs_frozen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "on_error": {
      "enum": [
        "continue",
        "stop"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "saved",
        "saved_with_warnings",
        "unchanged",
        "failed",
        "needs_decision",
        "not_started"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "saved": {
          "type": "integer",
          "minimum": 0
        },
        "saved_with_warnings": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "needs_decision": {
          "type": "integer",
          "minimum": 0
        },
        "not_started": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "position",
          "status",
          "operation_id",
          "snapshot_id",
          "sha256",
          "receipt_ref",
          "error",
          "warnings"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "saved",
              "saved_with_warnings",
              "unchanged",
              "failed",
              "needs_decision",
              "not_started"
            ]
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "next_action"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "next_action": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "details_ref"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "details_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "published": {
      "const": false
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "next_action"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "retryable": {
              "type": "boolean"
            },
            "next_action": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
