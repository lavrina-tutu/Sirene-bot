      "MPP_MAX_BYTES": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1099511627776
      },
      "ZIP_MAX_BYTES": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1099511627776
      },
      "ZIP_MAX_ENTRIES": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
