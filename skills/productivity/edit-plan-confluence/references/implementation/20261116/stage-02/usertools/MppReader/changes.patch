+READER_VERSION = "read-mpp-v2"
+
+
+def reader_versions() -> dict[str, str]:
+    """Identity of the installed reader, without starting a second read."""
+    from importlib.metadata import version
+    return {"reader": READER_VERSION, "mpxj": version("mpxj"), "jpype": version("JPype1")}
+
+
+def read_project_file(path: str, *, read_observer=None):
+    """Single instrumentable MPXJ read boundary, shared by CSV and full export.
+
+    The observer counts attempts (including failed reads), not function imports
+    or JVM starts. It must not read the input itself.
+    """
+    _start_jvm()
+    from org.mpxj.reader import UniversalProjectReader
+    reader = UniversalProjectReader()
+    if read_observer is not None:
+        read_observer({"event": "MPXJ_read", "path": str(path)})
+    project = reader.read(str(path))
+    if project is None:
+        raise RuntimeError(f"Не удалось прочитать файл: {path}")
+    return project
