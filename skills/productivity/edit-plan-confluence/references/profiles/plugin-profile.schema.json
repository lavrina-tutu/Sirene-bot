{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "plugin",
    "confluence_version",
    "codes",
    "capabilities",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "installed-gantt-profile"
    },
    "version": {
      "type": "string"
    },
    "confluence_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "asset_sha256"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "wrapper_asset_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "codes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "lag_unit"
      ],
      "properties": {
        "relation": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "FS",
              "SS",
              "FF",
              "SF"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "lag_unit": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "evidence",
          "scope"
        ],
        "properties": {
          "status": {
            "enum": [
              "tested_supported",
              "tested_unsupported",
              "not_verified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "display",
              "schedule"
            ]
          },
          "source_field": {
            "type": "string",
            "minLength": 1
          },
          "representation": {
            "type": "string",
            "minLength": 1
          },
          "required_checks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
